@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<!-- Toast Notification -->
<div ng-show="toastShow" style="animation: slideDown 0.5s ease-in-out"
     class="fixed top-4 right-4 z-[300] flex items-center gap-3 bg-white border shadow-sm rounded-2xl px-5 py-4 w-[350px] max-w-full transition-all duration-300"
     ng-class="{'border-green-200': toast.type === 'success', 'border-red-200': toast.type === 'error'}">
    <span class="font-medium text-[14px]" ng-class="{'text-green-700': toast.type === 'success', 'text-red-700': toast.type === 'error'}">
        {{ toast.message }}
    </span>
</div>

<div class="p-6" ng-init="isLoading = true; getAllPayments(); currentPage = 'Payments'">

    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-slate-900 text-2xl font-bold">Payments</h1>
            <p ng-if="!isLoading" class="text-slate-500 text-sm">{{ payments.length }} payment records</p>
            <div ng-if="isLoading" class="h-4 w-28 bg-slate-200 rounded animate-pulse mt-1"></div>
        </div>
    </div>

    <!-- Summary Cards (Skeleton State) -->
    <div ng-if="isLoading" class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6 animate-pulse">
        <div ng-repeat="i in [1, 2]" class="bg-slate-50 border border-slate-100 rounded-2xl p-4 flex flex-col justify-center gap-2">
            <div class="flex items-center gap-2">
                <div class="w-4 h-4 bg-slate-200 rounded"></div>
                <div class="h-4 w-16 bg-slate-200 rounded"></div>
            </div>
            <div class="h-8 w-28 bg-slate-200 rounded-lg"></div>
            <div class="h-3 w-20 bg-slate-200 rounded"></div>
        </div>
    </div>

    <!-- Summary Cards (Loaded State) -->
    <div ng-if="!isLoading" class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">

        <!-- Paid -->
        <div class="bg-emerald-50 border border-emerald-100 rounded-2xl p-4">
            <div class="flex items-center gap-2 mb-2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-emerald-600 flex-shrink-0">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="m9 12 2 2 4-4"></path>
                </svg>
                <span class="text-emerald-700 text-sm font-medium">Paid</span>
            </div>
            <p class="text-2xl font-bold text-emerald-800">₱{{ totalPaid | number:0 }}</p>
            <p class="text-emerald-600 text-xs mt-1">{{ countByPaymentStatus('Paid') }} payments</p>
        </div>

        <!-- Unpaid -->
        <div class="bg-amber-50 border border-amber-100 rounded-2xl p-4">
            <div class="flex items-center gap-2 mb-2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-amber-600 flex-shrink-0">
                    <rect width="20" height="14" x="2" y="5" rx="2"></rect>
                    <line x1="2" y1="10" x2="22" y2="10"></line>
                </svg>
                <span class="text-amber-700 text-sm font-medium">Unpaid</span>
            </div>
            <p class="text-2xl font-bold text-amber-800">₱{{ totalUnpaid | number:0 }}</p>
            <p class="text-amber-600 text-xs mt-1">{{ countByPaymentStatus('Unpaid') }} payments</p>
        </div>

    </div>

    <!-- Filters -->
    <div class="flex gap-2 mb-4 flex-wrap">
        <button ng-click="setPaymentStatusFilter('All')"
                ng-class="paymentFilter === 'All' ? 'bg-green-600 text-white' : 'bg-white text-slate-600 border border-slate-200 hover:border-slate-300'"
                class="px-4 py-2 rounded-xl text-sm font-medium transition-all">
            All
        </button>
        <button ng-click="setPaymentStatusFilter('Paid')"
                ng-class="paymentFilter === 'Paid' ? 'bg-green-600 text-white' : 'bg-white text-slate-600 border border-slate-200 hover:border-slate-300'"
                class="px-4 py-2 rounded-xl text-sm font-medium transition-all">
            Paid
        </button>
        <button ng-click="setPaymentStatusFilter('Unpaid')"
                ng-class="paymentFilter === 'Unpaid' ? 'bg-green-600 text-white' : 'bg-white text-slate-600 border border-slate-200 hover:border-slate-300'"
                class="px-4 py-2 rounded-xl text-sm font-medium transition-all">
            Unpaid
        </button>
    </div>

    <!-- Search -->
    <div class="relative mb-5">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input type="text" ng-model="paymentSearch" placeholder="Search payments..."
               class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-green-500" />
    </div>

    <!-- Table -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-100 text-left">
                        <th class="px-5 py-3 text-xs text-slate-500 font-medium whitespace-nowrap">Tenant</th>
                        <th class="px-5 py-3 text-xs text-slate-500 font-medium whitespace-nowrap">Unit</th>
                        <th class="px-5 py-3 text-xs text-slate-500 font-medium whitespace-nowrap">Period</th>
                        <th class="px-5 py-3 text-xs text-slate-500 font-medium whitespace-nowrap">Amount</th>
                        <th class="px-5 py-3 text-xs text-slate-500 font-medium whitespace-nowrap">Due Date</th>
                        <th class="px-5 py-3 text-xs text-slate-500 font-medium whitespace-nowrap">Status</th>
                        <th class="px-5 py-3 text-xs text-slate-500 font-medium whitespace-nowrap">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    <!-- Skeleton Loading State -->
                    <tr ng-if="isLoading" ng-repeat="i in [1, 2, 3, 4, 5]" class="animate-pulse">
                        <td class="px-5 py-3.5">
                            <div class="flex items-center gap-2">
                                <div class="w-7 h-7 bg-slate-200 rounded-full flex-shrink-0"></div>
                                <div class="h-4 w-28 bg-slate-200 rounded"></div>
                            </div>
                        </td>
                        <td class="px-5 py-3.5"><div class="h-4 w-16 bg-slate-200 rounded"></div></td>
                        <td class="px-5 py-3.5"><div class="h-4 w-20 bg-slate-200 rounded"></div></td>
                        <td class="px-5 py-3.5"><div class="h-4 w-16 bg-slate-200 rounded"></div></td>
                        <td class="px-5 py-3.5"><div class="h-4 w-24 bg-slate-200 rounded"></div></td>
                        <td class="px-5 py-3.5"><div class="h-5 w-16 bg-slate-200 rounded-full"></div></td>
                        <td class="px-5 py-3.5"><div class="h-7 w-20 bg-slate-200 rounded-lg"></div></td>
                    </tr>

                    <!-- Loaded Rows -->
                    <tr ng-if="!isLoading" ng-repeat="p in filteredPayments()"
                        class="hover:bg-slate-50 transition-colors">

                        <!-- Tenant -->
                        <td class="px-5 py-3">
                            <div class="flex items-center gap-2">
                                <div class="w-7 h-7 bg-green-100 rounded-full flex items-center justify-center text-green-700 text-xs font-semibold flex-shrink-0">
                                    {{ p.tenantName.charAt(0) }}
                                </div>
                                <span class="text-slate-900 text-sm whitespace-nowrap">{{ p.tenantName }}</span>
                            </div>
                        </td>

                        <!-- Unit -->
                        <td class="px-5 py-3 text-sm text-slate-600 whitespace-nowrap">{{ p.unitName }}</td>

                        <!-- Period -->
                        <td class="px-5 py-3 text-sm text-slate-600 whitespace-nowrap">{{ p.month }}</td>

                        <!-- Amount -->
                        <td class="px-5 py-3 text-sm text-slate-900 font-semibold whitespace-nowrap">₱{{ p.amount | number:0 }}</td>

                        <!-- Due Date -->
                        <td class="px-5 py-3 text-xs text-slate-500 whitespace-nowrap">
                            {{ p.dueDate }}
                            <span ng-if="p.paidDate" class="block text-emerald-600">Paid: {{ p.paidDate }}</span>
                        </td>

                        <!-- Status -->
                        <td class="px-5 py-3 whitespace-nowrap">
                            <span class="px-2 py-1 rounded-full text-xs font-medium"
                                  ng-class="{
                                    'bg-emerald-50 text-emerald-700': p.status === 'Paid',
                                    'bg-amber-50 text-amber-700': p.status === 'Unpaid'
                                  }">
                                {{ p.status }}
                            </span>
                        </td>

                        <!-- Action -->
                        <td class="px-5 py-3 whitespace-nowrap flex gap-4">
                            <button ng-if="p.status === 'Unpaid'"
                                    ng-click="openMarkPaidModal(p)"
                                    class="flex items-center gap-1.5 text-xs px-3 py-1.5 bg-emerald-50 text-emerald-700 hover:bg-emerald-100 rounded-lg transition-all">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><rect width="18" height="18" x="3" y="4" rx="2" ry="2" /><line x1="16" x2="16" y1="2" y2="6" /><line x1="8" x2="8" y1="2" y2="6" /><line x1="3" x2="21" y1="10" y2="10" /><path d="m9 16 2 2 4-4" /></svg>
                                Mark Paid
                            </button>


                        </td>
                    </tr>
                </tbody>
            </table>

            <!-- Empty State -->
            <div ng-if="!isLoading && filteredPayments().length === 0"
                 class="text-center py-12 text-slate-400 text-sm">
                No payments found
            </div>
        </div>
    </div>

</div>

<!-- ── Mark Paid Modal ── -->
<div ng-show="markPaidTarget" ng-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md flex flex-col max-h-[90vh]">

        <!-- Header -->
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
            <h2 class="text-slate-900 font-semibold text-base">Mark Payment as Paid</h2>
            <button ng-click="markPaidTarget = false" class="p-1.5 rounded-lg hover:bg-slate-100 text-slate-400 hover:text-slate-600 transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
            </button>
        </div>

        <!-- Body -->
        <div class="overflow-y-auto flex-1 p-6 space-y-5">

            <!-- Tenant Summary -->
            <div class="flex items-center gap-3 p-4 bg-slate-50 rounded-2xl border border-slate-100">
                <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center text-green-700 font-bold text-base flex-shrink-0">
                    {{ markPaidTarget.tenantName.charAt(0) }}
                </div>
                <div>
                    <p class="text-slate-900 text-sm font-medium">{{ markPaidTarget.tenantName }}</p>
                    <p class="text-slate-500 text-xs">{{ markPaidTarget.unitName }} · ₱{{ markPaidTarget.amount | number:0 }}/mo</p>
                </div>
                <div class="ml-auto text-right">
                    <p class="text-xs text-slate-400">Starting from</p>
                    <p class="text-sm font-semibold text-slate-800">{{ markPaidTarget.month }}</p>
                </div>
            </div>

            <!-- Paid Until Selector -->
            <div>
                <p class="text-sm text-slate-700 font-medium mb-1">Paid until:</p>
                <p class="text-xs text-slate-400 mb-3">
                    All months from <strong>{{ markPaidTarget.month }}</strong> through the selected month will be marked as
                    <span class="text-emerald-600 font-medium">Paid</span>.
                </p>

                <div class="grid grid-cols-3 sm:grid-cols-4 gap-2">
                    <button ng-repeat="opt in monthOptions"
                            type="button"
                            ng-click="selectPaidUntil(opt)"
                            ng-class="{
                                'bg-green-600 text-white border-green-600 shadow-md': paidUntil === opt.key,
                                'bg-green-50 text-green-700 border-green-200': isInRange(opt) && paidUntil !== opt.key,
                                'bg-white text-slate-600 border-slate-200 hover:border-green-300': !isInRange(opt) && paidUntil !== opt.key
                            }"
                            class="relative px-2 py-3 rounded-xl text-xs font-medium border transition-all">
                        <span class="block">{{ opt.shortMonth }}</span>
                        <span class="block text-xs" ng-class="paidUntil === opt.key ? 'text-green-200' : 'text-slate-400'">{{ opt.year }}</span>
                    </button>
                </div>


            </div>


            <button type="button"
                    ng-click="NotifModal = true"
                    class="flex items-center justify-center gap-2 bg-amber-50 text-sm w-full py-3.5 text-amber-600 font-semibold rounded-xl transition-colors hover:bg-amber-100">
                <!-- Your existing bell SVG -->
                <svg xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="w-3 h-3 flex-shrink-0">
                    <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
                    <path d="M10 21h4" />
                </svg>

                Notify
            </button>

            <!-- Preview -->
            <div ng-if="paidUntil" class="bg-emerald-50 border border-emerald-100 rounded-xl p-4">
                <p class="text-xs text-emerald-700 font-semibold mb-2 flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><path d="m9 11 3 3L22 4" /></svg>
                    Months to be marked Paid ({{ previewMonths.length }})
                </p>
                <div class="flex flex-wrap gap-1.5">
                    <span ng-repeat="m in previewMonths"
                          class="px-2 py-1 bg-emerald-100 text-emerald-700 rounded-lg text-xs font-medium">
                        {{ m }}
                    </span>
                </div>
                <p class="text-xs text-emerald-600 mt-2">
                    Total: <strong>₱{{ (markPaidTarget.amount * previewMonths.length) | number:0 }}</strong>
                </p>
            </div>

        </div>

        <!-- Footer -->
        <div class="flex gap-3 px-6 py-4 border-t border-slate-100">
            <button ng-click="markPaidTarget = false" class="flex-1 py-2.5 rounded-xl border border-slate-200 text-slate-600 text-sm font-medium hover:bg-slate-50 transition-all">
                Cancel
            </button>
            <button ng-click="confirmMarkPaid()" ng-disabled="!paidUntil"
                    class="flex-1 flex items-center justify-center gap-2 py-2.5 rounded-xl bg-green-600 hover:bg-green-700 disabled:opacity-50 text-white text-sm font-medium transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><rect width="18" height="18" x="3" y="4" rx="2" ry="2" /><line x1="16" x2="16" y1="2" y2="6" /><line x1="8" x2="8" y1="2" y2="6" /><line x1="3" x2="21" y1="10" y2="10" /><path d="m9 16 2 2 4-4" /></svg>
                {{isLoading ? 'Saving...' : 'Confirm & Mark Paid'}}
            </button>
        </div>
    </div>
</div>


<!-- Notification Modal -->
<div ng-show="NotifModal"
     ng-cloak
     class="fixed inset-0 z-[60] flex items-center justify-center bg-black/40 p-4">

    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md">

        <!-- Header -->
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
            <div>
                <h2 class="text-slate-900 font-semibold text-base">Send Notification</h2>
                <p class="text-slate-500 text-xs mt-1">
                    Select a notification to send to the tenant.
                </p>
            </div>

            <button type="button"
                    ng-click="NotifModal = false"
                    class="p-1.5 rounded-lg hover:bg-slate-100 text-slate-400 hover:text-slate-600 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round"
                     class="w-4 h-4">
                    <path d="m18 6-12 12M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Body -->
        <div class="p-6 space-y-4">

            <!-- Tenant -->
            <div class="flex items-center gap-3 p-3.5 bg-slate-50 rounded-xl border border-slate-100">
                <div class="w-10 h-10 rounded-full bg-green-100 text-green-700 flex items-center justify-center text-sm font-semibold flex-shrink-0">
                    {{ markPaidTarget.tenantName.charAt(0) }}
                </div>

                <div class="min-w-0">
                    <p class="text-sm font-semibold text-slate-900 truncate">
                        {{ markPaidTarget.tenantName }}
                    </p>
                    <p class="text-xs text-slate-500 mt-1">
                        Unit {{ markPaidTarget.unitName }}
                    </p>
                </div>
            </div>

            <!-- Notification Options -->
            <div>
                <p class="text-sm font-medium text-slate-700 mb-2">
                    Notification Type
                </p>

                <button type="button"
                        ng-click="selectedNotificationType = 'FailedPDC'"
                        ng-class="selectedNotificationType === 'FailedPDC'
                            ? 'border-red-300 bg-red-50 ring-1 ring-red-200'
                            : 'border-slate-200 bg-white hover:border-slate-300'"
                        class="w-full flex items-center gap-3 p-4 border rounded-xl text-left transition-colors">

                    <div class="w-10 h-10 rounded-xl bg-red-100 text-red-600 flex items-center justify-center flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round"
                             class="w-5 h-5">
                            <circle cx="12" cy="12" r="10" />
                            <path d="m15 9-6 6M9 9l6 6" />
                        </svg>
                    </div>

                    <div class="flex-1">
                        <p class="text-sm font-semibold text-slate-800">
                            Failed PDC Payment
                        </p>
                        <p class="text-xs text-slate-500 mt-1">
                            Notify the tenant about an unsuccessful post-dated check.
                        </p>
                    </div>

                    <svg ng-if="selectedNotificationType === 'FailedPDC'"
                         xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round"
                         class="w-5 h-5 text-red-600 flex-shrink-0">
                        <path d="m5 12 4 4L19 6" />
                    </svg>
                </button>
            </div>

            <p class="text-xs text-slate-400 leading-relaxed">
                The notification message will be generated automatically by the system.
            </p>

        </div>

        <!-- Footer -->
        <div class="flex gap-3 px-6 py-4 border-t border-slate-100">
            <button type="button"
                    ng-click="NotifModal = false"
                    class="flex-1 py-2.5 rounded-xl border border-slate-200 text-slate-600 text-sm font-medium hover:bg-slate-50 transition-colors">
                Cancel
            </button>

            <button type="button"
                    ng-click="sendPaymentNotification(markPaidTarget.Tid)"
                    ng-disabled="isSending || !selectedNotificationType"
                    class="flex-1 flex items-center justify-center gap-2 py-2.5 rounded-xl bg-green-600 hover:bg-green-700 disabled:opacity-50 disabled:cursor-not-allowed text-white text-sm font-semibold transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round"
                     class="w-4 h-4">
                    <path d="m22 2-7 20-4-9-9-4Z" />
                    <path d="M22 2 11 13" />
                </svg>
                {{isSending ? 'Sending' : 'Send Notification' }}
            </button>
        </div>

    </div>
</div>

